# Copy this file to .env and fill in values. Never commit .env.

# Port the Express server listens on. Defaults to 8080 when unset.
PORT=8080

# Microsoft Copilot Studio token endpoint URL.
# Copilot Studio: open your agent > Settings > Channels > Mobile app > Token Endpoint > Copy.
# Server-side only. The browser receives short-lived Direct Line tokens from /api/copilot/token.
# Leave empty to run without Copilot Studio (the panel shows a disconnected state).
COPILOT_TOKEN_ENDPOINT=
